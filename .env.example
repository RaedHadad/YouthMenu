DATABASE_URL="postgresql://username:password@localhost:5432/youthmenu?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/youthmenu?schema=public"
# Optional local Docker database. Set a password and use it in both URLs above
# with username youthmenu. URL-encode special characters in connection strings.
LOCAL_POSTGRES_PASSWORD=""
LOCAL_POSTGRES_PORT="5432"
# Tests only: must target localhost and a database name containing "test".
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/youthmenu_test?schema=public"
# Only for legacy version-1 customer tokens; admin sessions no longer use this.
SESSION_SECRET="replace-with-long-random-secret"
# Server-only AES-256 key for safely replaying order credentials. Generate with:
# openssl rand -hex 32
# Keep this stable and backed up; never expose it via NEXT_PUBLIC_.
ORDER_TOKEN_ENCRYPTION_KEY=""
# Ably kitchen pub/sub; server-only, never prefix with NEXT_PUBLIC_.
ABLY_API_KEY=""
# Optional scheduler authentication for outbox recovery (32+ random characters).
CRON_SECRET=""
UPSTASH_REDIS_URL="https://example.upstash.io"
UPSTASH_REDIS_TOKEN="replace-with-upstash-token"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# One-time provisioning only. Supply a unique password locally; no default exists.
ADMIN_PASSWORD=""
