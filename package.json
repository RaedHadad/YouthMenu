{
  "name": "youthmenu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "prisma generate",
    "db:validate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:status": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate status",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "orders:key": "node scripts/create-order-key.mjs",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.database.config.mts",
    "test:browser": "node --env-file-if-exists=.env.local scripts/test-browser.mjs",
    "admin:sessions": "node --env-file-if-exists=.env.local --import tsx scripts/admin-sessions.ts",
    "realtime:flush": "node --env-file-if-exists=.env.local --import tsx scripts/realtime-flush.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.38.4",
    "@zxing/browser": "^0.2.1",
    "ably": "^2.28.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
